set(ALGOFORGE_TOOLCHAIN_MSVC 0 CACHE BOOL "Build with Microsoft MSVC" FORCE)
set(ALGOFORGE_TOOLCHAIN_CLANG 1 CACHE BOOL "Build with LLVM clang-cl" FORCE)
if(WIN32)
  get_filename_component(ALGOFORGE_REPOSITORY_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
  if(NOT DEFINED ALGOFORGE_CLANG_CL)
    set(ALGOFORGE_CLANG_CL "${ALGOFORGE_REPOSITORY_ROOT}/.toolchains/llvm-22.1.8/bin/clang-cl.exe")
  endif()
  set(CMAKE_C_COMPILER "${ALGOFORGE_CLANG_CL}" CACHE FILEPATH "LLVM clang-cl C compiler" FORCE)
  set(CMAKE_CXX_COMPILER "${ALGOFORGE_CLANG_CL}" CACHE FILEPATH "LLVM clang-cl C++ compiler" FORCE)
else()
  set(CMAKE_C_COMPILER "clang" CACHE FILEPATH "LLVM C compiler" FORCE)
  set(CMAKE_CXX_COMPILER "clang++" CACHE FILEPATH "LLVM C++ compiler" FORCE)
endif()
